PORT=8090
NODE_ENV=development
DB_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/ban_ve_su_kien
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ban_ve_su_kien
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Cấu hình đăng nhập và khoá tài khoản (T-05 / S-02)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_IP_FAILED_ATTEMPTS=20
LOGIN_LOCK_SECONDS=900

# Cấu hình phiên đăng nhập (T-05 / S-02)
SESSION_COOKIE_NAME=session_token
SESSION_TTL_SECONDS=28800

# Demo Credentials for Seed (T-04)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=your_demo_admin_password
DEMO_ORGANIZER_EMAIL=organizer@example.com
DEMO_ORGANIZER_PASSWORD=your_demo_organizer_password

PORT=8090
NODE_ENV=development
TRUST_PROXY=false
# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
# LƯU Ý QUAN TRỌNG:
# 1. Thay "your_postgres_password" bằng mật khẩu PostgreSQL thực tế trên máy của bạn khi cài đặt (ví dụ: postgres, 123456...).
# 2. Nếu database chưa tồn tại trên máy local không có Docker/psql: Chạy "npm run db:create" để tự động tạo database.
DB_CONNECTION_STRING=postgresql://postgres:your_postgres_password@localhost:5432/ban_ve_su_kien
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ban_ve_su_kien
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_KEY_PREFIX=bvsk:

# Cấu hình đăng nhập và khoá tài khoản (T-05 / S-02)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_IP_FAILED_ATTEMPTS=20
LOGIN_LOCK_SECONDS=900

# Cấu hình phiên đăng nhập (T-05 / S-02)
SESSION_COOKIE_NAME=session_token
SESSION_TTL_SECONDS=28800

# Demo Credentials for Seed (T-04)
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=your_demo_admin_password
DEMO_ORGANIZER_EMAIL=organizer@example.com
DEMO_ORGANIZER_PASSWORD=your_demo_organizer_password

# Cấu hình ứng dụng và Email (T-07, T-08 / S-03)
APP_BASE_URL=http://localhost:8090
ACTIVATION_CODE_TTL_SECONDS=600
ACTIVATION_CODE_MAX_ATTEMPTS=5
MAIL_TRANSPORT=dev
BREVO_API_KEY=your_brevo_api_key
MAIL_TIMEOUT_MS=10000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
MAIL_FROM="Hệ Thống Bán Vé <no-reply@example.com>"

# Nghiệm thu staging (không dùng cho kết nối DB ứng dụng)
# STAGING_URL=https://your-service.onrender.com
# STAGING_EXPECTED_REVISION=<full-git-commit-sha>
# APP_REVISION được CI/nhà cung cấp deploy đặt tự động.
